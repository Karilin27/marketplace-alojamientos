          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Huésped Postman\",\n  \"correo\": \"{{correoHuesped}}\",\n  \"contrasena\": \"Clave2026*\",\n  \"rol\": \"HUESPED\"\n}"
        }
      }
    },
    {
      "name": "0.6 Iniciar sesión huésped",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenHuesped\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correoHuesped}}\",\n  \"contrasena\": \"Clave2026*\"\n}"
        }
      }
    },
    {
      "name": "HU-023 CA-01 · Listar políticas (CP-05-04)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "pm.test(\"Tres políticas\", () => pm.expect(p.map(x => x.nombre)).to.have.members([\"FLEXIBLE\",\"MODERADA\",\"ESTRICTA\"]));",
              "pm.collectionVariables.set(\"idModerada\", p.find(x => x.nombre === \"MODERADA\").id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cancellation-policies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cancellation-policies"
          ]
        }
      }
    },
    {
      "name": "HU-005 CP-05-01 · Crear A-01 en BORRADOR",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const a = pm.response.json();",
              "pm.test(\"BORRADOR y asociada al anfitrión\", () => { pm.expect(a.estado).to.eql(\"BORRADOR\"); pm.expect(a.politicaCancelacion.nombre).to.eql(\"MODERADA\"); });",
              "pm.collectionVariables.set(\"idA01\", a.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAnfitrion}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accommodations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accommodations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Apartamento Chapinero\",\n  \"descripcion\": \"Cerca a la zona G\",\n  \"tipo\": \"APARTAMENTO\",\n  \"ciudad\": \"Bogotá\",\n  \"direccion\": \"Calle 60 # 5-20\",\n  \"capacidad\": 4,\n  \"precioPorNoche\": 200000,\n  \"servicios\": [\n    \"WiFi\",\n    \"Cocina\"\n  ],\n  \"reglas\": \"No fumar\",\n  \"imagenes\": [\n    \"https://img.ejemplo.com/1.jpg\",\n    \"https://img.ejemplo.com/2.jpg\",\n    \"https://img.ejemplo.com/3.jpg\"\n  ],\n  \"idPoliticaCancelacion\": \"{{idModerada}}\"\n}"
        }
      }
    },
    {
      "name": "HU-017 CA-06 · Reseñas visibles de A-01 (público)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Estructura\", () => { pm.expect(r).to.include.keys(\"calificacionPromedio\",\"total\",\"resenas\"); pm.expect(r.resenas).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reviews?accommodationId={{idA01}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews"
          ],
          "query": [
            {
              "key": "accommodationId",
              "value": "{{idA01}}"
            }
          ]
        }
      }
    },
