{
  "info": {
    "name": "S5 Reseñas – Marketplace Inversiones LR",
    "description": "HU-017 y HU-025. Validaciones y permisos. Los casos con una reserva COMPLETADA (CP-16-01, CP-16-04, CP-22-01 y CP-22-02) requieren los datos de database/dev/seed_resenas.sql y un token de administrador. Ejecutar: newman run api/S5-resenas.postman_collection.json --env-var baseUrl=http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "0.1 Registrar anfitrión de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"correoAnfitrion\", \"anf\" + Date.now() + \"@test.com\");",
              "pm.collectionVariables.set(\"correoOtro\", \"otro\" + Date.now() + \"@test.com\");",
              "pm.collectionVariables.set(\"correoHuesped\", \"hue\" + Date.now() + \"@test.com\");"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Anfitrión Postman\",\n  \"correo\": \"{{correoAnfitrion}}\",\n  \"contrasena\": \"Clave2026*\",\n  \"rol\": \"ANFITRION\"\n}"
        }
      }
    },
    {
      "name": "0.2 Iniciar sesión anfitrión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenAnfitrion\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correoAnfitrion}}\",\n  \"contrasena\": \"Clave2026*\"\n}"
        }
      }
    },
    {
      "name": "0.5 Registrar huésped",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
