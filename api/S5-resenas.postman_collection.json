          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Indica ambos campos\", () => { const d = pm.response.json().detalles.join(\" \"); pm.expect(d).to.include(\"calificacion\"); pm.expect(d).to.include(\"comentario\"); });"
            ]
          }
        }
